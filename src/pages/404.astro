---
import Base from "../layouts/Base.astro";
import VarietyGrid from "../components/VarietyGrid.astro";
---
<Base title="Page Not Found | Associated Turf" description="The page you are looking for has moved." noindex>
  <section class="nf section">
    <div class="wrap-narrow center">
      <p class="label">Error 404</p>
      <h1>This Patch Hasn't Been Laid Yet</h1>
      <p class="lede" style="margin-inline:auto">The page you are after may have moved. Try our turf varieties, lawn advice or get in touch with the farm.</p>
      <div class="btn-row" style="justify-content:center;margin-top:1.5rem"><a class="btn" href="/">Back to Home</a><a class="btn btn--ghost" href="/contact/">Contact Us</a></div>
    </div>
  </section>
  <VarietyGrid />
</Base>
