---
import QuoteForm from "./QuoteForm.astro";
import Icon from "./Icon.astro";
import { business } from "../data/site";
interface Props { id?: string; title?: string; text?: string; formTitle?: string; formSub?: string; label?: string }
const {
  id = "quote",
  title = "Let's Talk About Your New Lawn",
  text = "Tell us where the turf is going and roughly how much you need. Our team will come back with fast, obligation free pricing and honest advice on the right variety.",
  formTitle = "Request Your Free Quote",
  formSub = "Fast, obligation free pricing from our turf team.",
  label = "Free quote",
} = Astro.props;
---
<section class="qs section lawn" id={id} data-drift>
  <div class="wrap qs__in">
    <div class="qs__copy">
      <p class="label">{label}</p>
      <h2>{title}</h2>
      <p class="lede">{text}</p>

      <div class="calc" data-calc>
        <div class="calc__top">
          <p class="calc__title"><Icon name="ruler" size={20} />Turf Calculator</p>
          <p class="calc__hint">Measure each lawn area in metres. Leave out garden beds and paths.</p>
        </div>
        <div class="calc__rows" data-calc-rows>
          <div class="calc__row" data-calc-row>
            <label><span>Length (m)</span><input inputmode="decimal" placeholder="12" data-l /></label>
            <span class="calc__x" aria-hidden="true">×</span>
            <label><span>Width (m)</span><input inputmode="decimal" placeholder="8" data-w /></label>
          </div>
        </div>
        <div class="calc__actions">
          <button type="button" class="calc__add" data-calc-add><Icon name="plus" size={16} />Add Another Area</button>
          <label class="calc__extra"><input type="checkbox" checked data-calc-extra /> Add 5% for cuts and edges</label>
        </div>
        <div class="calc__out">
          <p><span data-calc-total>0</span> m² <small>of turf</small></p>
          <button type="button" class="btn btn--ghost calc__use" data-calc-use>Add to My Quote</button>
        </div>
      </div>

      <ul class="qs__contact">
        <li><Icon name="phone" size={18} /><a href={business.phoneHref}>{business.phone}</a> <small>Free call</small></li>
        <li><Icon name="mail" size={18} /><a href={`mailto:${business.email}`}>{business.email}</a></li>
        <li><Icon name="truck" size={18} /><span>Delivery Monday to Saturday across Sydney and Regional NSW</span></li>
      </ul>
    </div>
    <div class="qs__form">
      <QuoteForm id={`${id}-form`} title={formTitle} sub={formSub} />
    </div>
  </div>
</section>

<style>
  .qs__in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .qs__copy .lede { margin-bottom: 1.75rem; }
  .calc { background: #fff; border-radius: var(--radius-md); border: 1px solid var(--color-line); padding: 1.25rem; }
  .calc__title { display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-display); font-weight: 650; font-size: 1.25rem; color: var(--color-forest); margin: 0; }
  .calc__title :global(svg) { color: var(--color-field); }
  .calc__hint { font-size: 0.9rem; color: var(--color-muted); margin: 0.25rem 0 1rem; }
  .calc__rows { display: grid; gap: 0.6rem; }
  .calc__row { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.6rem; align-items: end; }
  .calc__row label { display: grid; gap: 0.25rem; font-size: 0.8rem; font-weight: 600; color: var(--color-forest); }
  .calc__row input { font: inherit; width: 100%; padding: 0.7rem 0.85rem; border-radius: 10px; border: 1.5px solid var(--color-line); background: var(--color-paper); }
  .calc__row input:focus { outline: none; border-color: var(--color-field); box-shadow: 0 0 0 4px rgba(0, 163, 53, 0.15); }
  .calc__x { padding-bottom: 0.7rem; color: var(--color-muted); font-weight: 600; }
  .calc__actions { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.6rem; margin-top: 0.8rem; font-size: 0.9rem; }
  .calc__add { display: inline-flex; align-items: center; gap: 0.35rem; background: none; border: 0; color: var(--color-field-deep); font-weight: 600; padding: 0.3rem 0; }
  .calc__extra { display: inline-flex; align-items: center; gap: 0.45rem; color: var(--color-body); }
  .calc__extra input { accent-color: var(--color-field); width: 18px; height: 18px; }
  .calc__out { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-top: 1rem; padding-top: 1rem; border-top: 1px dashed var(--color-line); }
  .calc__out p { margin: 0; font-family: var(--font-display); font-size: 2rem; font-weight: 650; color: var(--color-forest); line-height: 1; }
  .calc__out small { font-family: var(--font-sans); font-size: 0.9rem; font-weight: 500; color: var(--color-muted); }
  .calc__use { min-height: 46px; padding-inline: 1.1rem; min-width: 0; }
  .qs__contact { list-style: none; padding: 0; margin: 1.75rem 0 0; display: grid; gap: 0.7rem; }
  .qs__contact li { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .qs__contact :global(svg) { color: var(--color-field); flex: none; }
  .qs__contact a { color: var(--color-forest); font-weight: 600; text-decoration: none; }
  .qs__contact small { color: var(--color-muted); }
  @media (max-width: 980px) { .qs__in { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 720px) {
    .qs__copy { text-align: center; }
    .qs__copy .lede { margin-inline: auto; }
    .calc { text-align: left; }
    .qs__contact { text-align: left; max-width: 420px; margin-inline: auto; }
    :global(html.is-inner) .qs__contact { text-align: center; }
    :global(html.is-inner) .qs__contact li { justify-content: center; }
    :global(html.is-inner) .calc__title { justify-content: center; }
    :global(html.is-inner) .calc__hint { text-align: center; }
    :global(html.is-inner) .calc__out { flex-direction: column; justify-content: center; }
  }
</style>
