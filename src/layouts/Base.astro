---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileBar from "../components/MobileBar.astro";
import ScrollTop from "../components/ScrollTop.astro";
import { business, img } from "../data/site";
import type { Faq } from "../lib/content";
import { plain } from "../lib/md";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  breadcrumb?: { name: string; path: string }[];
  faqs?: Faq[];
  noindex?: boolean;
  article?: { headline: string; date?: string; image?: string };
}
const { title, description, ogImage, breadcrumb = [], faqs = [], noindex = false, article } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.slice(baseUrl.length) || "/";
const canonical = new URL(path, business.url).href;
const preview = import.meta.env.PUBLIC_NOINDEX === "true";
const og = img(ogImage && !/associated-turf-logo/.test(ogImage) ? ogImage : "2026/05/home-banner-sunrise.jpg");

const org = {
  "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
  "@id": `${business.url}/#business`,
  name: business.name,
  legalName: business.legalName,
  url: business.url,
  telephone: "+611800044006",
  email: business.email,
  image: img("2026/05/home-banner-sunrise.jpg"),
  logo: img(business.logo),
  description: "Turf farm on the Hawkesbury River at Windsor growing and delivering farm fresh Buffalo, Kikuyu and Couch turf across Sydney and Regional NSW for over 45 years.",
  address: { "@type": "PostalAddress", streetAddress: business.street, addressLocality: business.locality, addressRegion: business.region, postalCode: business.postcode, addressCountry: "AU" },
  geo: { "@type": "GeoCoordinates", latitude: business.geo.lat, longitude: business.geo.lng },
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "08:00", closes: "16:30" },
    { "@type": "OpeningHoursSpecification", dayOfWeek: "Saturday", opens: "07:00", closes: "12:00" },
  ],
  areaServed: [{ "@type": "City", name: "Sydney" }, { "@type": "State", name: "New South Wales" }],
  sameAs: business.social.map((s) => s.href),
  priceRange: "$$",
};
const graph: object[] = [
  org,
  { "@type": "WebSite", "@id": `${business.url}/#website`, url: business.url, name: business.name, publisher: { "@id": `${business.url}/#business` } },
  { "@type": "WebPage", "@id": `${canonical}#webpage`, url: canonical, name: title, description, isPartOf: { "@id": `${business.url}/#website` }, primaryImageOfPage: og },
];
if (breadcrumb.length) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: [{ name: "Home", path: "/" }, ...breadcrumb].map((b, i) => ({ "@type": "ListItem", position: i + 1, name: b.name, item: new URL(b.path, business.url).href })),
  });
}
if (faqs.length) graph.push({ "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: plain(f.q), acceptedAnswer: { "@type": "Answer", text: plain(f.a) } })) });
if (article) graph.push({ "@type": "BlogPosting", headline: article.headline, datePublished: article.date, image: article.image ? img(article.image) : og, author: { "@id": `${business.url}/#business` }, publisher: { "@id": `${business.url}/#business` }, mainEntityOfPage: canonical });
const ld = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });
const gtm = import.meta.env.PUBLIC_GTM_ID as string | undefined;
---
<!doctype html>
<html lang="en-AU" id="top" class:list={[{ "is-inner": path !== "/" }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || preview) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0c2419" />
    <link rel="icon" href={img("2019/05/favico.png")} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content="Associated Turf" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,500..700,0..100,0..1&family=Poppins:wght@400;500;600&display=swap" />
    <script is:inline>
      (function () {
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("js-motion");
      })();
    </script>
    <script type="application/ld+json" set:html={ld} />
    {gtm && <script is:inline define:vars={{ gtm }}>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtm);</script>}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <div class="mowline" aria-hidden="true">
      <span class="mowline__cut"></span>
      <svg class="mowline__mower" viewBox="0 0 26 22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h15l2.5 5H3z" fill="#fff"/><path d="M18 12 23 2"/><circle cx="7" cy="18" r="2.4" fill="#fff"/><circle cx="17" cy="18" r="2.4" fill="#fff"/></svg>
    </div>
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <ScrollTop />
    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
