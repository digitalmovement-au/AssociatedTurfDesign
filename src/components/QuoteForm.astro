---
import { varieties, business } from "../data/site";
interface Props { id?: string; title?: string; sub?: string }
const { id = "quote-form", title = "Request Your Free Quote", sub = "Fast, obligation free pricing from our turf team." } = Astro.props;
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined;
---
<form
  class="qf"
  id={id}
  name="quote"
  method="POST"
  action={endpoint ?? "/thank-you/"}
  data-quote-form
  data-endpoint={endpoint}
  data-netlify={endpoint ? undefined : "true"}
  netlify-honeypot="company_website"
  novalidate
>
  <input type="hidden" name="form-name" value="quote" />
  <div class="qf__head">
    <p class="qf__title">{title}</p>
    <p class="qf__sub">{sub}</p>
  </div>
  <div class="qf__grid">
    <div class="field"><label for={`${id}-name`}>Your name</label><input id={`${id}-name`} name="name" autocomplete="name" placeholder="Jane Smith" required /><span class="err" aria-live="polite"></span></div>
    <div class="field"><label for={`${id}-phone`}>Phone</label><input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" placeholder="0400 000 000" required /><span class="err" aria-live="polite"></span></div>
    <div class="field"><label for={`${id}-email`}>Email</label><input id={`${id}-email`} name="email" type="email" autocomplete="email" placeholder="you@email.com" required /><span class="err" aria-live="polite"></span></div>
    <div class="field"><label for={`${id}-suburb`}>Delivery suburb</label><input id={`${id}-suburb`} name="suburb" autocomplete="address-level2" placeholder="Windsor" /><span class="err"></span></div>
    <div class="field"><label for={`${id}-variety`}>Turf variety</label>
      <select id={`${id}-variety`} name="variety" data-variety>
        <option>Not sure, please advise</option>
        {varieties.map((v) => <option>{v.name}</option>)}
      </select>
    </div>
    <div class="field"><label for={`${id}-area`}>Area (m²)</label><input id={`${id}-area`} name="area" inputmode="decimal" placeholder="120" data-area /><span class="err"></span></div>
    <fieldset class="qf__full qf__opts">
      <legend>I need</legend>
      <label><input type="radio" name="service" value="Supply and delivery" checked /> <span>Supply and delivery</span></label>
      <label><input type="radio" name="service" value="Supply and laying" /> <span>Supply and laying</span></label>
      <label><input type="radio" name="service" value="Farm pick-up" /> <span>Farm pick-up</span></label>
    </fieldset>
    <div class="field qf__full"><label for={`${id}-msg`}>Anything else?</label><textarea id={`${id}-msg`} name="message" placeholder="Backyard gets afternoon shade. We'd like delivery on a Saturday in early March." data-msg></textarea></div>
    <p class="hp" aria-hidden="true"><label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off" /></label></p>
  </div>
  <button class="btn qf__submit" type="submit">Get My Free Quote</button>
  <p class="qf__status" role="status" aria-live="polite"></p>
  <p class="qf__alt">Prefer to talk? Call the farm on <a href={business.phoneHref}>{business.phone}</a></p>
</form>

<style>
  .qf { background: #fff; color: var(--color-ink); border-radius: var(--radius-lg); padding: clamp(1.35rem, 3vw, 2.25rem); box-shadow: var(--shadow); border: 1px solid var(--color-line); position: relative; }
  .qf::before { content: ""; position: absolute; left: clamp(1.35rem, 3vw, 2.25rem); right: clamp(1.35rem, 3vw, 2.25rem); top: 0; height: 6px; border-radius: 0 0 6px 6px; background: repeating-linear-gradient(90deg, var(--color-field) 0 26px, var(--color-sprout) 26px 52px); }
  .qf__title { font-family: var(--font-display); font-weight: 650; font-size: clamp(1.5rem, 2.2vw, 1.85rem); line-height: 1.1; color: var(--color-forest); margin: 0.35rem 0 0.35rem; text-transform: capitalize; }
  .qf__sub { color: var(--color-muted); font-size: 0.95rem; margin: 0 0 1.35rem; }
  .qf__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  .qf__full { grid-column: 1 / -1; }
  .qf__opts { border: 0; padding: 0; margin: 0.15rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .qf__opts legend { font-size: 0.88rem; font-weight: 600; color: var(--color-forest); margin-bottom: 0.45rem; padding: 0; }
  .qf__opts label { position: relative; cursor: pointer; }
  .qf__opts input { position: absolute; opacity: 0; inset: 0; }
  .qf__opts span { display: inline-block; padding: 0.55rem 0.95rem; border-radius: 999px; border: 1.5px solid var(--color-line); font-size: 0.92rem; font-weight: 500; transition: background 0.2s, border-color 0.2s, color 0.2s; }
  .qf__opts input:checked + span { background: var(--color-forest); border-color: var(--color-forest); color: #fff; }
  .qf__opts input:focus-visible + span { outline: 3px solid var(--color-field); outline-offset: 2px; }
  .qf__submit { width: 100%; margin-top: 1.2rem; white-space: normal; }
  .qf__status { font-size: 0.95rem; margin: 0.75rem 0 0; }
  .qf__status:empty { display: none; }
  .qf__status.ok { color: var(--color-field-deep); font-weight: 600; }
  .qf__status.bad { color: #c2381f; }
  .qf__alt { text-align: center; font-size: 0.9rem; color: var(--color-muted); margin: 0.9rem 0 0; }
  .qf__alt a { color: var(--color-field-deep); font-weight: 600; text-decoration: none; }
  .hp { position: absolute; left: -9999px; }
  @media (max-width: 540px) { .qf__grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 720px) { .qf__head { text-align: center; } .qf__opts { justify-content: center; } .qf__opts legend { width: 100%; text-align: center; } }
</style>
