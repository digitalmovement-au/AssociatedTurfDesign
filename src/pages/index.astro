---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ReviewsWall from "../components/ReviewsWall.astro";
import VarietyMarquee from "../components/VarietyMarquee.astro";
import VarietyGrid from "../components/VarietyGrid.astro";
import Faq from "../components/Faq.astro";
import PostCards from "../components/PostCards.astro";
import QuoteSection from "../components/QuoteSection.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { business, img, varieties, steps } from "../data/site";
import { all, firstImage, get, tokenize } from "../lib/content";

const faqs = [
  { q: "Which turf type is best for shade?", a: "Buffalo grasses like Matilda, Sir Walter and Shademaster are the best performers in shady areas. Matilda and Sir Walter thrive with as little as 3 to 4 hours of direct sunlight. Kikuyu and Couch varieties such as Wintergreen and Greenlees Park need full sun (6+ hours daily)." },
  { q: "Which turf has the best drought tolerance?", a: "Sir Walter and Matilda Soft Leaf Buffalo are both excellent for drought tolerance due to their deep root systems and broad leaf blades that retain moisture. Kikuyu is also drought tough, though it may brown off more quickly in extreme heat." },
  { q: "What is the best turf for high wear areas or pets?", a: "Kikuyu is very hardy and fast repairing, making it a top choice for active families, pets and high traffic lawns. Sir Walter and Matilda are also durable but recover more slowly from heavy wear." },
  { q: "Which turf is the lowest maintenance?", a: "Sir Walter and Matilda Soft Leaf Buffalo are considered low maintenance due to their low thatch build up, slow vertical growth and minimal fertiliser needs. Kikuyu and Couch varieties grow quickly and require more frequent mowing and edging." },
  { q: "What is the difference between Matilda and Sir Walter?", a: "Both are premium soft leaf Buffalo varieties with similar traits, but Matilda is a semi dwarf variety with finer leaves and a denser growth habit. It can feel softer underfoot and may need slightly less mowing." },
  { q: "Which turf establishes the fastest after laying?", a: "Kikuyu establishes the fastest thanks to its vigorous growth habit. Couch grasses also establish quickly in warm weather. Buffalo varieties establish more slowly but form a dense, weed resistant lawn once mature." },
];
const projects = ["New homes", "Lawn renovations", "Landscapers", "Builders", "Schools", "Councils", "Sporting fields", "Commercial developments", "Parks", "Display homes"];
const posts = all("post").filter((p) => p.date && firstImage(p)).sort((a, b) => (b.date ?? "").localeCompare(a.date ?? "")).slice(0, 3);

const statement = [
  { line: "Choosing the right supplier matters", mark: true },
  { line: "as much as choosing the right grass." },
];
type Seg = { t?: string; icon?: string; accent?: boolean };
const story: Seg[] = [
  { t: "For over 45 years Associated Turf", accent: true }, { icon: "award" },
  { t: "has supplied homeowners," }, { icon: "home" },
  { t: "landscapers, builders and councils with lush, healthy Buffalo, Kikuyu and Couch turf," }, { icon: "leaf" },
  { t: "cut to order" }, { icon: "scissors" },
  { t: "and delivered direct from our farm." }, { icon: "truck" },
];
const features = [
  { icon: "scissors", title: "Harvested fresh to order", body: "Every roll is cut on demand with modern harvesting machinery, never stockpiled, so your turf arrives green, moist and ready to lay the same day.", image: "2023/01/maxi-5.jpg" },
  { icon: "pin", title: "Grown on the Hawkesbury River", body: "Our farm sits on the Cornwallis Flats at Windsor, where the river has built up rich, fertile soil for dense turf with strong roots.", image: "2018/10/SFPP4050.jpg" },
  { icon: "grid", title: "Six varieties for every yard", body: "Matilda, Sir Walter and Shademaster buffalo, Kikuyu, Greenlees Park and Wintergreen couch, matched to your sun, shade and lifestyle.", image: "2023/02/gal2023-7.jpg" },
  { icon: "truck", title: "Delivered Monday to Saturday", body: "On time delivery across Sydney and Regional NSW, with pallets for building sites and machine-laid Maxi Turf rolls for large open areas.", image: "2023/01/maxi-4.jpg" },
];
const works = [
  { image: "2024/03/sir-walter-1.jpg", title: "Sir Walter Buffalo lawn", tag: "Residential" },
  { image: "2026/10/kikuyu-backyard-lawn.jpg", title: "Kikuyu backyard", tag: "Residential" },
  { image: "2026/10/greenlees-park-couch-home-lawn.jpg", title: "Greenlees Park Couch lawn", tag: "Residential" },
  { image: "2023/01/maxi-7.jpg", title: "Maxi Turf installation", tag: "Commercial" },
  { image: "2024/03/sir-walter-2.jpg", title: "Sir Walter Buffalo lawn", tag: "Residential" },
  { image: "2026/10/greenlees-park-couch-playing-field.jpg", title: "Greenlees Park Couch playing field", tag: "Sports field" },
  { image: "2026/10/kikuyu-park-lawn.jpg", title: "Kikuyu park lawn", tag: "Public space" },
  { image: "2024/03/wintergreen-3.jpg", title: "Wintergreen Couch lawn", tag: "Residential" },
];
const sun = varieties.filter((v) => ["kikuyu", "wintergreen", "greenlees-park"].includes(v.slug));
const shade = varieties.filter((v) => ["matilda", "sir-walter", "shademaster"].includes(v.slug));
const cmp = tokenize(get("/turf-varieties/")!.lines).find((t) => t.t === "table") as { head: string[]; rows: string[][] };
---
<Base title="Associated Turf Supplies Sydney | Instant Turf Supplier Sydney" description="Associated Turf Supplies Sydney - Farm fresh turf grass suppliers. Matilda Soft Leaf Buffalo, Kikuyu grass supplies. Delivery to Sydney metro" faqs={faqs}>

  <section class="hx">
    <img class="hx__bg" src={img("2026/05/home-banner-sunrise.jpg")} alt="Sunrise over freshly mown turf at the Associated Turf farm" width="1920" height="1080" fetchpriority="high" />
    <div class="hx__shade" aria-hidden="true"></div>
    <div class="wrap hx__in">
      <div class="hx__copy">
        <p class="tape">Sydney's trusted turf supplier</p>
        <h1 class="hx__h1">Premium Instant Turf, Harvested Fresh and Delivered Across Sydney</h1>
        <p class="hx__lede">For over 45 years we have supplied lush, healthy Buffalo, Kikuyu and Couch turf, cut to order and delivered direct from our Windsor farm.</p>
        <div class="hx__btns">
          <a class="btn btn--outline-light" href={business.phoneHref}><Icon name="phone" size={18} />{business.phone}</a>
        </div>
      </div>
      <div class="hx__form">
        <QuoteForm id="hero-form" compact title="Request Your Free Quote" sub="Fast, obligation free pricing from our turf team." />
      </div>
    </div>
  </section>

  <ReviewsWall />

  <section class="pin pin--about" data-scrub data-words>
    <div class="pin__stick dots">
      <div class="wrap mg st sy">
        <p class="st__text display">
          {statement.map((l) => (
            <span class:list={["st__line", l.mark && "st__line--mark"]}>{l.line.split(" ").map((w) => <span class="w" data-w>{w} </span>)}</span>
          ))}
        </p>
        <p class="sy__text display">
          {story.map((s) => s.icon
            ? <span class="sy__ic w" data-w aria-hidden="true"><Icon name={s.icon} size={26} /></span>
            : s.t!.split(" ").map((w) => <span class:list={["w", s.accent && "w--accent"]} data-w>{w} </span>)
          )}
        </p>
        <div class="sy__tail">
          <p class="sy__more">Our range includes Sir Walter Buffalo, Matilda Soft Leaf Buffalo, Kikuyu, Wintergreen Couch and Greenlees Park Couch, harvested fresh to order and grown to the highest standards for long lasting results.</p>
          <ul class="st__chips" data-chips>
          <li><span><Icon name="scissors" size={17} /></span>Cut fresh to order</li>
          <li><span><Icon name="truck" size={17} /></span>Sydney wide delivery</li>
          <li><span><Icon name="chat" size={17} /></span>Expert lawn advice</li>
        </ul>
          <div class="btn-row sy__btns">
            <a class="btn" href="/turf-varieties/">Explore Our Turf</a>
            <a class="btn btn--ghost" href="/turf-farms/">About Our Farm</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="wk section">
    <div class="wrap">
      <div class="wk__head">
        <div>
          <p class="label">Sample works</p>
          <h2 class="wk__h">Lawns We Have Grown and Laid</h2>
          <p class="wk__sub">Grown at Windsor. Laid across Sydney, from family backyards to parks and playing fields.</p>
        </div>
      </div>
      <ul class="wk__grid">
        {works.map((w, i) => (
          <li class="wk__item" data-fade>
            <a href={img(w.image)} data-lightbox data-index={i} aria-label={`View larger photo: ${w.title}`}>
              <img src={img(w.image)} alt={w.title} width="800" height="600" loading="lazy" decoding="async" />
              <span class="wk__cap"><strong>{w.title}</strong><span>{w.tag}</span></span>
            </a>
          </li>
        ))}
      </ul>
      <div class="wk__cta"><a class="btn" href="/turf-gallery/">View Full Gallery <Icon name="arrow" size={18} /></a></div>
    </div>
  </section>

  <VarietyMarquee />

  <section class="bl section dots">
    <div class="wrap">
      <div class="head head--center bl__head">
        <p class="label">Why Associated Turf</p>
        <h2 class="bl__h">Better Lawns Start at the Farm</h2>
        <p class="lede">We grow, harvest and deliver every roll ourselves, so you get fresher turf, consistent quality and advice from the people who know it best.</p>
      </div>
      <ul class="bl__grid">
        {features.map((f) => (
          <li class="bl__card" data-fade>
            <div class="bl__img"><img src={img(f.image)} alt="" width="800" height="600" loading="lazy" decoding="async" /></div>
            <div class="bl__body">
              <span class="bl__ic"><Icon name={f.icon} size={20} /></span>
              <h3 class="bl__t">{f.title}</h3>
              <p class="bl__b">{f.body}</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="btn-row bl__btns sec-cta"><a class="btn" href="#quote">Get a Free Quote</a><a class="btn btn--ghost" href="/turf-supply/">How We Supply</a></div>
    </div>
  </section>

  <section class="sw" data-sunshade>
    <div class="wrap sw__in">
      <div class="sw__scene">
        <img class="sw__img is-on" src={img("2026/10/wintergreen-couch-golf-course.jpg")} alt="A couch lawn in full sun" width="1000" height="700" loading="lazy" data-sunshade-img="sun" />
        <img class="sw__img" src={img("2024/03/sir-walter-2.jpg")} alt="A soft leaf buffalo lawn in part shade" width="1000" height="700" loading="lazy" data-sunshade-img="shade" />
        <button class="sw__toggle" type="button" role="switch" aria-checked="false" aria-label="Shady yard" data-sunshade-btn>
          <span>Shade</span>
          <span class="sw__track"><span class="sw__knob"></span><span data-sunshade-state>Off</span></span>
        </button>
      </div>
      <div class="sw__copy">
        <div class="sw__panel" data-panel="sun">
          <p class="label">Full sun, 6+ hours a day</p>
          <h2>When your yard is in full sun:</h2>
          <p>Kikuyu and couch varieties such as Wintergreen and Greenlees Park need full sun to stay thick. Kikuyu is hardy and fast repairing, while the couches give a premium fine leaf finish.</p>
          <ul class="sw__picks">{sun.map((v) => <li><a href={v.href}>{v.name}<Icon name="arrow" size={16} /></a></li>)}</ul>
        </div>
        <div class="sw__panel" data-panel="shade" hidden>
          <p class="label">Part shade, 3 to 4 hours of sun</p>
          <h2>When your yard is shaded:</h2>
          <p>Buffalo grasses are the best performers in shady areas. Matilda and Sir Walter thrive with as little as 3 to 4 hours of direct sunlight, while Shademaster is up to 85% shade tolerant.</p>
          <ul class="sw__picks">{shade.map((v) => <li><a href={v.href}>{v.name}<Icon name="arrow" size={16} /></a></li>)}</ul>
        </div>
        <p class="sw__hint">Flip the shade switch to compare.</p>
      </div>
    </div>
  </section>

  <section class="ho section dots" data-steps-hw>
    <div class="wrap">
      <div class="head head--center">
        <p class="label">How it works</p>
        <h2 class="ho__h">From Our Farm to Your Lawn in Four Simple Steps</h2>
        <p class="lede">Ordering premium turf has never been easier. Our team guides you through every stage.</p>
      </div>
      <ol class="hw">
        {steps.map((st, i) => (
          <li class="hw__step" data-hw>
            <span class="hw__n">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="hw__t">{st.title}</h3>
            <p class="hw__b">{st.body}</p>
          </li>
        ))}
      </ol>
      <div class="sec-cta"><a class="btn" href="#quote">Get a Free Quote</a></div>
    </div>
  </section>

  <VarietyGrid />

  <section class="cl section dots" data-collage>
    <div class="wrap cl__in">
      <div class="cl__copy">
        <p class="label">Residential and commercial</p>
        <h2>No Project Too Large or Too Small</h2>
        <p class="lede">Whether you need a few square metres for your backyard or thousands of square metres for a major development, our experienced team will recommend the best turf for your project.</p>
        <ul class="cl__tags">{projects.map((p) => <li>{p}</li>)}</ul>
        <div class="btn-row"><a class="btn" href="#quote">Request a Quote</a><a class="btn btn--ghost" href="/commercial-turf-supply/">Commercial Supply</a></div>
      </div>
      <div class="cl__stack">
        <figure class="pol pol--1"><img src={img("2018/10/Turf-pics-050.jpg")} alt="Fresh Matilda turf" width="500" height="400" loading="lazy" /></figure>
        <figure class="pol pol--2"><img src={img("2018/10/IMG_1699.jpg")} alt="Maxi Turf rolls being laid" width="500" height="400" loading="lazy" /></figure>
        <figure class="pol pol--3"><img src={img("2018/10/QYUM2745.jpg")} alt="Turf growing at the farm" width="500" height="400" loading="lazy" /></figure>
        <figure class="pol pol--4"><img src={img("2018/10/Turf-pics-052.jpg")} alt="A freshly laid lawn" width="500" height="400" loading="lazy" /></figure>
      </div>
    </div>
  </section>


  <section class="sp section">
    <div class="wrap">
      <div class="head head--center sp__head">
        <h2>Turf at a Glance</h2>
      </div>
      <div class="sp__grid">
        {cmp.rows.map((r) => {
          const v = varieties.find((x) => r[0].toLowerCase().startsWith(x.short.toLowerCase()));
          return (
            <article class="sp__card">
              <h3><a href={v?.href ?? "/turf-varieties/"}>{r[0]}</a></h3>
              <dl>{cmp.head.slice(1).map((h, i) => <div><dt>{h}</dt><dd>{r[i + 1]}</dd></div>)}</dl>
            </article>
          );
        })}
      </div>
      <div class="sec-cta"><a class="btn" href="/turf-varieties/">Full Variety Guide <Icon name="arrow" size={18} /></a></div>
    </div>
  </section>

  <Faq title="Got Questions? We've Got Answers" items={faqs} intro="Not sure which turf suits your property? Here are the questions we hear most. Our team is always happy to help." />
  <PostCards posts={posts} />

  <section class="end">
    <img class="end__bg" src={img("2026/10/kikuyu-backyard-lawn.jpg")} alt="" width="1920" height="900" loading="lazy" />
    <div class="wrap end__in">
      <h2>Ready to Transform Your Lawn?</h2>
      <p>Contact our friendly team today for expert advice, an obligation free quote or help choosing the perfect turf for your home or project.</p>
      <div class="btn-row"><a class="btn btn--light" href="#quote">Get a Free Quote</a><a class="btn btn--outline-light" href={business.phoneHref}><Icon name="phone" size={18} />{business.phone}</a></div>
    </div>
  </section>

  <QuoteSection title="Let's Talk About Your New Lawn" label="Free quote" />
</Base>

<style>
  .dots { background-color: var(--color-paper); background-image: radial-gradient(rgba(12, 36, 25, 0.07) 1px, transparent 1.2px); background-size: 14px 14px; }

  /* Hero */
  .hx { position: relative; min-height: calc(100svh - var(--header-h) - 38px); display: flex; align-items: center; color: #fff; overflow: hidden; isolation: isolate; }
  .hx__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  :global(html.js-motion) .hx__bg { animation: hx-in 2.4s var(--ease) both; }
  @keyframes hx-in { from { transform: scale(1.08); } }
  .hx__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(8, 22, 15, 0.1) 0%, rgba(8, 22, 15, 0.25) 45%, rgba(8, 22, 15, 0.8) 100%), linear-gradient(90deg, rgba(8, 22, 15, 0.55), transparent 65%); }
  .hx__in { padding-block: clamp(2.5rem, 6vw, 4.5rem); display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, 480px); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .tape { display: inline-block; background: var(--color-field); color: #fff; font-family: var(--font-display); font-style: italic; font-weight: 600; font-size: 1.05rem; padding: 0.3rem 0.95rem; transform: rotate(-3deg); clip-path: polygon(2% 0, 100% 5%, 98% 100%, 0 94%); margin-bottom: 1.25rem; }
  .hx__h1 { color: #fff; font-size: clamp(2.5rem, 5.2vw, 5.2rem); max-width: 14ch; margin-bottom: 0.35em; letter-spacing: -0.025em; }
  .hx__lede { font-size: clamp(1.02rem, 1.2vw, 1.15rem); max-width: 48ch; color: rgba(255, 255, 255, 0.9); margin-bottom: 1.5rem; }
  .hx__btns { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; }
  .hx__btns .btn { min-width: 230px; }
  .hx__form :global(.qf) { box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.55); }
  @media (max-width: 1100px) { .hx__in { grid-template-columns: minmax(0, 1fr) minmax(320px, 420px); } }
  @media (max-width: 900px) { .hx { min-height: 0; } .hx__in { grid-template-columns: minmax(0, 1fr); padding-top: 4rem; } }
  @media (max-width: 720px) { .hx { text-align: center; } .hx__h1, .hx__lede { margin-inline: auto; } .hx__btns { flex-direction: column; } .hx__btns .btn { min-width: 0; width: 100%; } .hx__form { text-align: left; } }

  /* Scenes: no scroll pinning; each plays its reveal once it comes into view. */
  .pin { position: relative; }
  .pin__stick { position: relative; display: flex; align-items: center; overflow: hidden; padding-block: clamp(4.5rem, 9vw, 7.5rem); }

  .w { transition: filter 0.3s linear, opacity 0.3s linear; }
  :global(html.js-motion) [data-words] .w { opacity: 0.16; filter: blur(7px); }
  :global(html.js-motion) [data-words] .w.on { opacity: 1; filter: none; }

  .st { text-align: center; }
  .st__text { font-size: clamp(2.1rem, 5.2vw, 4.8rem); line-height: 1.12; color: var(--color-forest); margin: 0 auto 2.5rem; text-transform: none; }
  .st__line { display: block; }
  .st__line--mark { color: var(--color-field); }
  .st__line--mark .w { background: linear-gradient(var(--color-field), var(--color-field)) no-repeat 0 96% / calc(var(--ul, 1) * 100%) 0.08em; padding-bottom: 0.06em; }
  .st__chips { list-style: none; padding: 0.4rem; margin: 0 auto; display: inline-flex; align-items: stretch; background: #fff; border: 1px solid var(--color-line); border-radius: 999px; box-shadow: 0 18px 40px -26px rgba(12, 36, 25, 0.45); }
  .st__chips li { display: inline-flex; align-items: center; gap: 0.65rem; padding: 0.45rem 1.35rem 0.45rem 0.5rem; font-weight: 600; font-size: 0.95rem; color: var(--color-forest); transition: opacity 0.5s, transform 0.5s var(--ease); }
  .st__chips li + li { border-left: 1px solid var(--color-line); padding-left: 1.1rem; }
  .st__chips li span { flex: none; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--color-field); color: #fff; }
  :global(html.js-motion) .st__chips:not(.on) li { opacity: 0; transform: translateY(10px); }
  .st__chips li:nth-child(2) { transition-delay: 0.1s; }
  .st__chips li:nth-child(3) { transition-delay: 0.2s; }
  @media (max-width: 720px) {
    .st__chips { display: flex; flex-direction: column; align-items: stretch; width: min(100%, 320px); border-radius: 22px; padding: 0.35rem 0.9rem; }
    .st__chips li { padding: 0.75rem 0.25rem; }
    .st__chips li + li { border-left: 0; border-top: 1px solid var(--color-line); padding-left: 0.25rem; }
  }


  .sy { text-align: center; }
  .sy__text { font-size: clamp(1.55rem, 3vw, 2.8rem); line-height: 1.32; color: var(--color-forest); margin: 0 auto 1.75rem; max-width: 34ch; text-transform: none; }
  .w--accent { color: var(--color-field-deep); }
  .sy__ic { display: inline-grid; place-items: center; width: 1.45em; height: 1.1em; vertical-align: -0.14em; margin-right: 0.25em; border-radius: 0.3em; background: var(--color-stripe-b); color: var(--color-field-deep); }
  .sy__ic :global(svg) { width: 0.62em; height: 0.62em; }
  .sy__more { font-size: 1.08rem; max-width: 60ch; margin-inline: auto; }
  .sy__btns { margin-top: 1.5rem; justify-content: center; }
  @media (max-width: 720px) { .sy__text { font-size: 1.45rem; } .sy__more { font-size: 0.98rem; } .sy__btns .btn--ghost { display: none; } .st__text { font-size: 1.9rem; } }
  :global(html.js-motion) .sy__tail { opacity: var(--tail, 0); transform: translateY(calc((1 - var(--tail, 0)) * 16px)); }
  [data-words] .w { transition: filter 0.45s ease, opacity 0.45s ease; transition-delay: calc(var(--i, 0) * 28ms); }
  .st__line--mark .w { transition: filter 0.45s ease, opacity 0.45s ease, background-size 0.7s var(--ease) 0.4s; }
  :global(html.js-motion) .sy__tail { transition: opacity 0.6s ease 1.6s, transform 0.6s var(--ease) 1.6s; }

  /* Merged statement + story: one centred column */
  .mg { text-align: center; }
  .mg .st__text { font-size: clamp(2.1rem, 4.2vw, 4rem); margin: 0 auto 1.5rem; max-width: none; }
  .mg .sy__text { font-size: clamp(1.3rem, 2.2vw, 1.9rem); margin: 0 auto 1.25rem; max-width: none; }
  .mg .sy__more { margin: 0 auto 1.75rem; max-width: none; }
  .mg .st__chips { margin: 0 auto; }
  .mg .sy__btns { justify-content: center; margin-top: 1.75rem; }
  .mg .st__chips li { white-space: nowrap; }

  @media (max-width: 900px) {
  }

  .sw { background: var(--color-forest); color: #cfe0d4; padding-block: clamp(4rem, 8vw, 7rem); transition: background 0.6s; }
  .sw.is-shade { background: #081a12; }
  .sw__in { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .sw__scene { position: relative; aspect-ratio: 16 / 11; border-radius: var(--radius-lg); overflow: hidden; background: #071610; }
  .sw__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.8s var(--ease); }
  .sw__img.is-on { opacity: 1; }
  .sw__toggle { position: absolute; right: 1rem; top: 1rem; display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.45rem 0.5rem 0.45rem 0.85rem; border: 0; border-radius: 12px; background: #fff; color: var(--color-forest); font-weight: 700; font-size: 0.9rem; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3); }
