---
import { varieties, img } from "../data/site";
import Icon from "./Icon.astro";
const opts = [
  { id: "shade", icon: "shade", label: "Shady yards", title: "Best for shade", body: "Buffalo grasses are the best performers in shady areas. Matilda and Sir Walter thrive with as little as 3 to 4 hours of direct sunlight, while Shademaster is up to 85% shade tolerant.", picks: ["matilda", "sir-walter", "shademaster"] },
  { id: "wear", icon: "footprints", label: "Kids and pets", title: "Best for high wear", body: "Kikuyu is hardy and fast repairing, making it a top choice for active families, pets and high traffic lawns. Sir Walter and Matilda are also durable options.", picks: ["kikuyu", "sir-walter", "matilda"] },
  { id: "dry", icon: "drop", label: "Drought tolerance", title: "Best for dry conditions", body: "Sir Walter and Matilda Soft Leaf Buffalo have deep root systems and broad leaf blades that retain moisture. Kikuyu is also drought tough.", picks: ["sir-walter", "matilda", "kikuyu"] },
  { id: "easy", icon: "leaf", label: "Low maintenance", title: "Easiest to look after", body: "Sir Walter and Matilda have low thatch build up, slow vertical growth and minimal fertiliser needs. Shademaster also requires minimal mowing.", picks: ["sir-walter", "matilda", "shademaster"] },
  { id: "fine", icon: "feather", label: "Premium finish", title: "Best for a manicured look", body: "For a premium fine leaf finish, Wintergreen and Greenlees Park Couch provide exceptional presentation in sunny locations.", picks: ["wintergreen", "greenlees-park"] },
];
const by = (s: string) => varieties.find((v) => v.slug === s)!;
---
<section class="sel section" data-selector>
  <div class="wrap">
    <div class="head head--center">
      <p class="label">Turf selector</p>
      <h2>Which Turf Is Right for Your Home?</h2>
      <p class="lede">Selecting the right turf depends on your lifestyle, property and maintenance preferences. Choose what matters most to you.</p>
    </div>
    <div class="sel__tabs" role="tablist" aria-label="Select what matters most to you">
      {opts.map((o, i) => (
        <button type="button" role="tab" id={`sel-tab-${o.id}`} aria-controls={`sel-panel-${o.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-sel-tab>
          <Icon name={o.icon} size={20} />{o.label}
        </button>
      ))}
    </div>
    {opts.map((o, i) => (
      <div class="sel__panel" role="tabpanel" id={`sel-panel-${o.id}`} aria-labelledby={`sel-tab-${o.id}`} hidden={i !== 0} data-sel-panel>
        <div class="sel__why">
          <p class="sel__for">Our recommendation for <strong>{o.label.toLowerCase()}</strong></p>
          <h3 class="h2">{o.title}</h3>
          <p>{o.body}</p>
          <a class="btn" href="#quote" data-pick={by(o.picks[0]).name}>Get a Quote for This Turf</a>
        </div>
        <ol class="sel__picks">
          {o.picks.map((s, k) => {
            const v = by(s);
            return (
              <li>
                <a href={v.href}>
                  <img src={img(v.image)} alt="" width="240" height="180" loading="lazy" decoding="async" />
                  <span class="sel__rank">{k === 0 ? "Top pick" : `Also great`}</span>
                  <span class="sel__name">{v.name}</span>
                  <Icon name="arrow" size={18} />
                </a>
              </li>
            );
          })}
        </ol>
      </div>
    ))}
  </div>
</section>
<style>
  .sel { background: #fff; border-block: 1px solid var(--color-line); }
  .sel__tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; margin-bottom: 2rem; }
  .sel__tabs button { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.2rem; border-radius: 999px; border: 1.5px solid var(--color-line); background: var(--color-paper); color: var(--color-forest); font-weight: 600; font-size: 0.97rem; transition: background 0.25s, color 0.25s, border-color 0.25s, transform 0.3s var(--ease); }
  .sel__tabs button:hover { transform: translateY(-2px); border-color: var(--color-field); }
  .sel__tabs button[aria-selected="true"] { background: var(--color-forest); border-color: var(--color-forest); color: #fff; }
  .sel__tabs button :global(svg) { color: var(--color-field); }
  .sel__tabs button[aria-selected="true"] :global(svg) { color: var(--color-sprout); }
  .sel__panel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: center; padding: clamp(1.5rem, 3vw, 2.5rem); border-radius: var(--radius-lg); background: var(--color-stripe-a); }
  .sel__panel[hidden] { display: none; }
  :global(html.js-motion) .sel__panel:not([hidden]) { animation: sel-in 0.5s var(--ease); }
  @keyframes sel-in { from { opacity: 0; transform: translateY(10px); } }
  .sel__for { color: var(--color-muted); margin-bottom: 0.4rem; }
  .sel__for strong { color: var(--color-field-deep); }
  .sel__why .h2 { font-size: clamp(1.8rem, 2.8vw, 2.5rem); }
  .sel__why .btn { margin-top: 0.75rem; }
  .sel__picks { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .sel__picks a { display: grid; grid-template-columns: 96px 1fr auto; grid-template-rows: auto auto; column-gap: 1rem; align-items: center; padding: 0.7rem; padding-right: 1.1rem; background: #fff; border-radius: var(--radius-md); text-decoration: none; color: var(--color-forest); border: 1px solid var(--color-line); transition: transform 0.35s var(--ease), border-color 0.25s; }
  .sel__picks a:hover { transform: translateX(6px); border-color: var(--color-field); }
  .sel__picks img { grid-row: 1 / 3; width: 96px; height: 72px; object-fit: cover; border-radius: 10px; }
  .sel__rank { font-size: 0.8rem; font-weight: 600; color: var(--color-field-deep); align-self: end; }
  .sel__name { font-family: var(--font-display); font-weight: 650; font-size: 1.2rem; align-self: start; line-height: 1.2; }
  .sel__picks a :global(svg) { grid-row: 1 / 3; grid-column: 3; color: var(--color-field); }
  .sel__picks li:first-child a { border-color: var(--color-field); box-shadow: 0 16px 34px -26px rgba(0, 120, 40, 0.7); }
  @media (max-width: 900px) { .sel__panel { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 720px) { .sel__why { text-align: center; } .sel__tabs button { font-size: 0.9rem; padding: 0.65rem 1rem; } }
</style>
