---
import { whyUs, stats } from "../data/site";
import Icon from "./Icon.astro";
interface Props { title?: string; text?: string; label?: string; showStats?: boolean }
const {
  title = "Superior Lawn and Turf Supplies, Delivered Farm Fresh",
  text = "Choosing the right supplier matters as much as choosing the right grass. We are committed to premium products, expert advice and exceptional service from your first enquiry until your new lawn is established.",
  label = "Why Associated Turf",
  showStats = true,
} = Astro.props;
---
<section class="why section section--forest lawn lawn--forest" data-drift>
  <div class="wrap">
    <div class="head head--split">
      <div><p class="label">{label}</p><h2>{title}</h2></div>
      <p class="lede">{text}</p>
    </div>
    {showStats && (
      <ul class="why__stats">
        {stats.map((s) => (
          <li><p class="why__num display"><span data-count={s.value}>{s.value}</span>{s.suffix}</p><p class="why__lbl">{s.label}</p></li>
        ))}
      </ul>
    )}
    <ul class="why__grid">
      {whyUs.map((w) => (
        <li data-fade>
          <span class="why__ic"><Icon name={w.icon} size={24} /></span>
          <div><h3>{w.title}</h3><p>{w.body}</p></div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why__stats { list-style: none; padding: 0; margin: 0 0 clamp(2.5rem, 5vw, 4rem); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid rgba(255, 255, 255, 0.14); border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
  .why__stats li { padding: 1.5rem 1.25rem; display: flex; align-items: baseline; gap: 0.9rem; }
  .why__stats li + li { border-left: 1px solid rgba(255, 255, 255, 0.14); }
  .why__num { font-size: clamp(2.6rem, 4.4vw, 3.8rem); color: #fff; margin: 0; line-height: 1; }
  .why__lbl { margin: 0; color: #cfe0d4; font-size: 0.95rem; line-height: 1.35; max-width: 12ch; }
  .why__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; }
  .why__grid li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; padding: 1.75rem 1.5rem 1.75rem 0; border-bottom: 1px solid rgba(255, 255, 255, 0.12); }
  .why__grid li:nth-child(3n + 2), .why__grid li:nth-child(3n + 3) { padding-left: 1.5rem; border-left: 1px solid rgba(255, 255, 255, 0.12); }
  .why__ic { width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; background: var(--color-field); color: #fff; }
  .why__grid h3 { font-size: 1.3rem; margin-bottom: 0.35rem; }
  .why__grid p { margin: 0; color: #cfe0d4; }
  @media (max-width: 980px) {
    .why__stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .why__stats li:nth-child(3) { border-left: 0; }
    .why__stats li:nth-child(n + 3) { border-top: 1px solid rgba(255, 255, 255, 0.14); }
    .why__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .why__grid li, .why__grid li:nth-child(n) { padding: 1.5rem 1.25rem; border-left: 0; }
    .why__grid li:nth-child(even) { border-left: 1px solid rgba(255, 255, 255, 0.12); }
  }
  @media (max-width: 640px) {
    .why__stats li { flex-direction: column; align-items: center; text-align: center; gap: 0.4rem; padding: 1.25rem 0.75rem; }
    .why__lbl { max-width: none; }
    .why__grid { grid-template-columns: minmax(0, 1fr); }
    .why__grid li, .why__grid li:nth-child(n) { grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; border-left: 0; padding-inline: 0; }
  }
</style>
