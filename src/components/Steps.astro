---
import { steps } from "../data/site";
interface Props { title?: string; text?: string; label?: string }
const {
  title = "From Our Farm to Your Lawn in Four Simple Steps",
  text = "Ordering premium turf has never been easier. Our team guides you through every stage.",
  label = "How it works",
} = Astro.props;
---
<section class="steps section" data-steps>
  <div class="wrap">
    <div class="head head--center"><p class="label">{label}</p><h2>{title}</h2><p class="lede">{text}</p></div>
    <div class="steps__track" aria-hidden="true">
      <span class="steps__lawn"></span>
      <span class="steps__cut"></span>
      <svg class="steps__mower" viewBox="0 0 26 22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h15l2.5 5H3z" fill="#fff"/><path d="M18 12 23 2"/><circle cx="7" cy="18" r="2.4" fill="#fff"/><circle cx="17" cy="18" r="2.4" fill="#fff"/></svg>
    </div>
    <ol class="steps__list">
      {steps.map((s, i) => (
        <li style={`--n:${i}`}>
          <span class="steps__n">{String(i + 1).padStart(2, "0")}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
    <div class="btn-row steps__cta"><a class="btn" href="#quote">Start With a Free Quote</a></div>
  </div>
</section>

<style>
  .steps { --sp: 0; }
  .steps__track { position: relative; height: 26px; margin: 0 auto 2.5rem; max-width: 100%; }
  .steps__lawn, .steps__cut { position: absolute; left: 0; top: 8px; height: 10px; border-radius: 6px; }
  .steps__lawn { right: 0; background: repeating-linear-gradient(90deg, #b7d9bf 0 3px, #cfe6d4 3px 6px); }
  .steps__cut { width: calc(var(--sp) * 100%); background: repeating-linear-gradient(90deg, var(--color-field) 0 34px, #34c25e 34px 68px); }
  .steps__mower { position: absolute; top: -1px; left: calc(var(--sp) * 100%); width: 30px; height: 26px; transform: translateX(-70%); color: var(--color-forest); }
  .steps__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(1rem, 2.5vw, 2rem); }
  .steps__list li { position: relative; padding-top: 0.25rem; }
  .steps__n { display: inline-grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; font-family: var(--font-display); font-weight: 650; font-size: 1.15rem; color: var(--color-forest); background: #fff; border: 2px solid var(--color-line); margin-bottom: 1rem; transition: background 0.4s, color 0.4s, border-color 0.4s; }
  .steps__list li.is-done .steps__n { background: var(--color-field); border-color: var(--color-field); color: #fff; }
  .steps__list h3 { margin-bottom: 0.4rem; }
  .steps__list p { margin: 0; }
  .steps__cta { justify-content: center; margin-top: clamp(2rem, 4vw, 3rem); }
  @media (max-width: 900px) { .steps__list { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 2rem; } }
  @media (max-width: 560px) {
    .steps__track { display: none; }
    .steps__list { grid-template-columns: minmax(0, 1fr); text-align: center; }
    .steps__list li .steps__n { background: var(--color-field); border-color: var(--color-field); color: #fff; }
  }
</style>
