---
import { testimonials, business } from "../data/site";
import Icon from "./Icon.astro";
interface Props { title?: string }
const { title = "Loved by Sydney Homeowners and Landscapers" } = Astro.props;
---
<section class="rev section--tight">
  <div class="wrap rev__in">
    <div class="rev__head">
      <p class="label">Customer reviews</p>
      <h2 class="h3">{title}</h2>
      <a class="link" href={business.reviewsUrl} target="_blank" rel="noopener">Read our Google reviews <Icon name="arrow" size={16} /></a>
    </div>
    <ul class="rev__list">
      {testimonials.map((t) => (
        <li>
          <p class="rev__stars" aria-label="5 out of 5 stars">{Array.from({ length: 5 }, () => <Icon name="star" size={16} />)}</p>
          <blockquote><p>{t.quote}</p></blockquote>
          <p class="rev__who"><strong>{t.name}</strong> {t.place}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .rev { border-block: 1px solid var(--color-line); background: #fff; }
  .rev__in { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: center; }
  .rev__head h2 { margin-bottom: 0.6rem; }
  .rev__list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .rev__list li { padding: 1.4rem 1.5rem; border-radius: var(--radius-md); background: var(--color-stripe-a); }
  .rev__stars { display: flex; gap: 2px; color: var(--color-sun); margin: 0 0 0.6rem; }
  blockquote { margin: 0; font-family: var(--font-display); font-size: 1.2rem; line-height: 1.4; color: var(--color-forest); font-variation-settings: "SOFT" 100; }
  .rev__who { margin: 0.75rem 0 0; font-size: 0.92rem; color: var(--color-muted); }
  .rev__who strong { color: var(--color-forest); }
  @media (max-width: 900px) { .rev__in { grid-template-columns: minmax(0, 1fr); text-align: center; } .rev__head .label { justify-content: center; } }
  @media (max-width: 620px) { .rev__list { grid-template-columns: minmax(0, 1fr); } .rev__stars { justify-content: center; } }
</style>
